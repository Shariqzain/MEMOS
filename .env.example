# ─────────────────────────────────────────────────────────────
# MEMOS — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── MongoDB ───────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=memos

# ── ChromaDB ──────────────────────────────────────────────────
# Embedded mode: set CHROMA_MODE=embedded and provide a persist path
# Server mode:   set CHROMA_MODE=http and provide host/port
CHROMA_MODE=embedded
CHROMA_PERSIST_PATH=./data/chroma
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ── Neo4j ─────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j
# Set to false to disable Neo4j and use graph-fallback mode
NEO4J_ENABLED=true

# ── LLM Provider ──────────────────────────────────────────────
# Options: ollama | openai | gemini | anthropic
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=

# ── Embedding Model ───────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Override to use Ollama for embeddings instead of sentence-transformers
EMBEDDING_PROVIDER=sentence_transformers

# ── Retrieval Configuration ───────────────────────────────────
SEMANTIC_RETRIEVAL_LIMIT=20
GRAPH_RETRIEVAL_LIMIT=15
FINAL_CONTEXT_LIMIT=8
SIMILARITY_THRESHOLD=0.35
RRF_K=60

# ── Memory Retention Policy ───────────────────────────────────
MIN_IMPORTANCE_SCORE=0.35
MIN_CONFIDENCE_SCORE=0.40
MEMORY_DEDUP_THRESHOLD=0.92

# ── Application ───────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Demo User ─────────────────────────────────────────────────
DEMO_USER_ID=demo_user
DEMO_USER_NAME=Demo User
